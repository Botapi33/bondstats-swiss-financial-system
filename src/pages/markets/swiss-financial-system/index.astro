---
import { switzerlandFinancialSystem as entries } from '@swiss/data/switzerlandFinancialSystem';
const canonical='https://www.bondstats.org/markets/swiss-financial-system/';
const categories=[...new Set(entries.map(x=>x.category))];
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Swiss Financial System',description:'A BondStats reference to the monetary plumbing, CHF money markets, Pfandbrief system, sovereign funding, financial infrastructure and institutional balance sheets behind Swiss finance.',url:canonical,mainEntity:{'@type':'ItemList',numberOfItems:entries.length,itemListElement:entries.map((x,i)=>({'@type':'ListItem',position:i+1,name:x.name,url:canonical+x.slug+'/'}))}};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Swiss Financial System: 100 Market Mechanisms | BondStats</title><meta name="description" content="Explore 100 specialist concepts behind Swiss finance: SNB monetary plumbing, SARON, Pfandbriefe, CHF funding, sovereign debt, settlement, bank resolution, mortgages and institutional capital."><link rel="canonical" href={canonical}><meta name="robots" content="index,follow,max-snippet:-1"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><style>:root{--bg:#050807;--panel:#08100d;--line:#193027;--green:#45e3a2;--text:#edf5f1;--muted:#91a19a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}.wrap{width:min(1240px,calc(100% - 32px));margin:auto}.top{border-bottom:1px solid var(--line);padding:20px 0}.brand{font-weight:850;letter-spacing:.04em;color:inherit;text-decoration:none}.brand span,.k,.num{color:var(--green)}.hero{padding:72px 0 42px;border-bottom:1px solid var(--line)}.k{font:750 10px ui-monospace,monospace;letter-spacing:.18em}.hero h1{font:450 clamp(48px,7vw,84px)/.98 Georgia,serif;letter-spacing:-.05em;margin:16px 0 18px;max-width:1000px}.lead{max-width:900px;color:#b4c0ba;font-size:18px;line-height:1.75}.stats{display:flex;gap:34px;margin-top:30px;color:#71827a;font:700 10px ui-monospace,monospace;letter-spacing:.1em}.stats b{display:block;color:#fff;font-size:23px;letter-spacing:0}.controls{display:grid;grid-template-columns:1fr auto;gap:16px;padding:28px 0 16px}.search{background:#07100c;border:1px solid #254638;border-radius:8px;padding:15px;color:#fff;font:inherit}.filters{display:flex;gap:7px;overflow:auto;padding-bottom:20px}.filters button{white-space:nowrap;border:1px solid var(--line);background:transparent;color:#9baba3;border-radius:999px;padding:8px 11px;cursor:pointer}.filters button.active{border-color:#3e8d6c;color:var(--green)}.list{border-top:1px solid var(--line);margin-bottom:80px}.row{display:grid;grid-template-columns:52px minmax(220px,.7fr) minmax(190px,.55fr) 1.5fr;gap:18px;padding:18px 8px;border-bottom:1px solid #14251f;color:inherit;text-decoration:none}.row:hover{background:#07100d}.num{font:700 10px ui-monospace,monospace}.term{font-weight:760}.cat{font:700 10px/1.5 ui-monospace,monospace;color:#6f8e80;text-transform:uppercase;letter-spacing:.06em}.def{color:#98a69f;font-size:13px;line-height:1.6}.note{border-top:1px solid var(--line);padding:28px 0 60px;color:#71827a;font-size:12px;line-height:1.7}@media(max-width:800px){.controls{grid-template-columns:1fr}.row{grid-template-columns:34px 1fr}.cat,.def{grid-column:2}.stats{gap:18px;flex-wrap:wrap}}</style></head><body><header class="top"><div class="wrap"><a class="brand" href="/">BOND<span>STATS</span></a></div></header><main class="wrap"><section class="hero"><div class="k">SWITZERLAND · FINANCIAL ARCHITECTURE</div><h1>Inside the Swiss financial system.</h1><p class="lead">A specialist reference to the mechanisms underneath Swiss markets: SNB monetary plumbing, SARON and CHF funding, the Pfandbrief system, Confederation and cantonal finance, settlement infrastructure, bank resolution, mortgages and institutional capital.</p><div class="stats"><span><b>{entries.length}</b>REFERENCE PAGES</span><span><b>{categories.length}</b>SYSTEM LAYERS</span><span><b>101</b>TOTAL CLUSTER ROUTES</span></div></section><div class="controls"><input id="q" class="search" placeholder="Search Swiss financial architecture…" aria-label="Search Swiss financial architecture"><div class="k">CURATED · NO GENERATED FILTER URLS</div></div><div class="filters"><button class="active" data-cat="all">All</button>{categories.map(c=><button data-cat={c}>{c}</button>)}</div><div class="list">{entries.map((x,i)=><a class="row" href={`/markets/swiss-financial-system/${x.slug}/`} data-cat={x.category} data-search={`${x.name} ${x.category} ${x.definition}`.toLowerCase()}><span class="num">{String(i+1).padStart(3,'0')}</span><span class="term">{x.name}</span><span class="cat">{x.category}</span><span class="def">{x.definition}</span></a>)}</div><p class="note">BondStats reference content is independently written for analytical and educational use. Official Swiss authorities and infrastructure operators remain authoritative for current rules, legal definitions, rates and operating procedures.</p></main><script is:inline>(()=>{const q=document.querySelector('#q'),rows=[...document.querySelectorAll('.row')],bs=[...document.querySelectorAll('.filters button')];let cat='all';const run=()=>{const s=(q.value||'').trim().toLowerCase();rows.forEach(r=>r.style.display=(cat==='all'||r.dataset.cat===cat)&&(!s||r.dataset.search.includes(s))?'grid':'none')};q.addEventListener('input',run);bs.forEach(b=>b.addEventListener('click',()=>{bs.forEach(x=>x.classList.remove('active'));b.classList.add('active');cat=b.dataset.cat;run()}))})();</script></body></html>