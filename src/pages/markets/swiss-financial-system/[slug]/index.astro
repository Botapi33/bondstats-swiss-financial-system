---
import { switzerlandFinancialSystem as entries } from '@swiss/data/switzerlandFinancialSystem';
export function getStaticPaths(){return entries.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props; const canonical=`https://www.bondstats.org/markets/swiss-financial-system/${item.slug}/`;
const peers=entries.filter(x=>x.category===item.category&&x.slug!==item.slug).slice(0,6);
const schema={'@context':'https://schema.org','@graph':[{'@type':'DefinedTerm',name:item.name,description:item.definition,url:canonical,inDefinedTermSet:'https://www.bondstats.org/markets/swiss-financial-system/'},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Switzerland',item:'https://www.bondstats.org/markets/swiss-financial-system/'},{'@type':'ListItem',position:2,name:item.name,item:canonical}]}]};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{item.name}: Swiss Market Mechanics | BondStats</title><meta name="description" content={item.definition}><link rel="canonical" href={canonical}><meta name="robots" content="index,follow,max-snippet:-1"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><style>:root{--bg:#050807;--line:#1a3027;--green:#45e3a2;--text:#edf5f1;--muted:#95a49d}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}.wrap{width:min(980px,calc(100% - 32px));margin:auto}.top{padding:20px 0;border-bottom:1px solid var(--line)}.brand{color:inherit;text-decoration:none;font-weight:850;letter-spacing:.04em}.brand span,.k{color:var(--green)}.crumb{margin-top:8px;color:#73837b;font-size:12px}.crumb a{color:inherit;text-decoration:none}.hero{padding:62px 0 38px}.k{font:750 10px ui-monospace,monospace;letter-spacing:.16em}.hero h1{font:450 clamp(44px,7vw,76px)/1 Georgia,serif;letter-spacing:-.045em;margin:15px 0 20px}.lead{font:400 19px/1.72 Georgia,serif;color:#c2cdc7;max-width:880px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin:34px 0}.meta div{background:#07100c;padding:17px}.meta small{display:block;color:#698077;font:700 9px ui-monospace,monospace;letter-spacing:.12em;margin-bottom:7px}.meta strong{font-size:13px}.grid{display:grid;grid-template-columns:1fr 250px;gap:42px;padding-bottom:70px}.block{border-top:1px solid var(--line);padding:29px 0}.block h2{font:450 28px/1.2 Georgia,serif;margin:0 0 12px}.block p{color:#a9b6b0;line-height:1.82;margin:0}.side{border-left:1px solid var(--line);padding-left:22px}.side h3{color:var(--green);font:750 10px ui-monospace,monospace;letter-spacing:.12em}.peer{display:block;color:#b8c4be;text-decoration:none;padding:11px 0;border-bottom:1px solid #14251f;font-size:13px}.peer:hover{color:var(--green)}.note{font-size:12px;color:#718079;line-height:1.7;border-top:1px solid var(--line);padding-top:20px}@media(max-width:760px){.grid{grid-template-columns:1fr}.side{border-left:0;padding-left:0}.meta{grid-template-columns:1fr}.hero{padding-top:45px}}</style></head><body><header class="top"><div class="wrap"><a class="brand" href="/">BOND<span>STATS</span></a><div class="crumb"><a href="/markets/swiss-financial-system/">Swiss Financial System</a> / {item.name}</div></div></header><main class="wrap"><section class="hero"><div class="k">{item.category.toUpperCase()}</div><h1>{item.name}</h1><p class="lead">{item.definition}</p><div class="meta"><div><small>SYSTEM LAYER</small><strong>{item.layer}</strong></div><div><small>PRIMARY-SOURCE STARTING POINT</small><strong>{item.source}</strong></div></div></section><div class="grid"><article><section class="block"><h2>How {item.name} works</h2><p>{item.mechanics}</p></section><section class="block"><h2>Why it matters for Swiss markets</h2><p>{item.why}</p></section><section class="block"><h2>What to watch</h2><p>{item.watch}</p></section><section class="block"><h2>Limits and interpretation</h2><p>{item.limitations}</p></section><p class="note">BondStats educational market reference. This page describes financial-system mechanics and is not investment, legal, accounting or regulatory advice.</p></article><aside class="side"><h3>RELATED SWISS MECHANISMS</h3>{peers.map(x=><a class="peer" href={`/markets/swiss-financial-system/${x.slug}/`}>{x.name}</a>)}</aside></div></main></body></html>